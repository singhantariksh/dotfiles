#!/bin/bash

# Target the TOML file where your touchpad settings live
FILE="$HOME/.config/umbriel/touchpad.toml"
KEYWORD="disable_on_external_mouse"

if grep -q "^\s*$KEYWORD\s*=\s*true" "$FILE"; then
  sed -i "s/^\(\s*\)$KEYWORD\s*=\s*true/\1$KEYWORD = false/" "$FILE"
  noctalia msg notification-show "Touchpad Enabled"
else 
  sed -i "s/^\(\s*\)$KEYWORD\s*=\s*false/\1$KEYWORD = true/" "$FILE"
  noctalia msg notification-show "Touchpad Disabled"
fi
