include "input.kdl"
include "output.kdl"
include "layout.kdl"
include "binds.kdl"
include "window-layer.kdl"

hotkey-overlay {
  skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/%s.png"

animations {
}

layer-rule {
  match namespace="^quickshell-overview$"
  place-within-backdrop true
}

debug {
  honor-xdg-activation-with-invalid-serial
}

layer-rule {
  match namespace="^noctalia-wallpaper*"
  place-within-backdrop true
}

overview {
  workspace-shadow {
    off
  }
}

cursor {
  xcursor-theme "ArcDusk-cursors"
  xcursor-size 24

  hide-after-inactive-ms 3000
  hide-when-typing
}

gestures {
  hot-corners {
    off
  }
}

clipboard {
  disable-primary
}

switch-events {
  lid-close { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
  // lid-close { spawn "noctalia" "msg" "session" "lock"; }
}

// spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
spawn-at-startup "noctalia"
spawn-at-startup "easyeffects" "--gapplication-service"
